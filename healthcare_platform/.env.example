# MedCore Health - Example Environment Configuration
# Copy to .env (never commit .env or config/config.local.php to GitHub)
# Local fallback also supports config/config.local.php (see config/config.example.php)

HP_DB_HOST=localhost
HP_DB_NAME=healthcare_platform
HP_DB_USER=root
HP_DB_PASS=your_mysql_password_here
HP_DB_CHARSET=utf8mb4

# URL where the Python FastAPI Multi-Cancer ML microservice is reachable
HP_AI_SERVICE_URL=http://127.0.0.1:8000
